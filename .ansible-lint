---
exclude_paths:
  - inventory/intended*
  - inventory/documentation*
  - .venv/
  - .ansible/
  - .gitlab-ci.yml
  - .gitlab/
  - clab/

mock_roles:
  - arista.avd.eos_designs
  - arista.avd.eos_cli_config_gen
  - arista.avd.cv_deploy
  - arista.avd.anta_runner

mock_modules:
  - arista.avd.cv_workflow

skip_list:
  - yaml[line-length]
  - yaml[brackets]
  - var-naming[no-role-prefix]
