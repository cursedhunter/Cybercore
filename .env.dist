# credentials to push images to gitlab registry
# see https://docs.gitlab.com/ee/user/packages/container_registry/
GITLAB_USER=<user>
GITLAB_TOKEN=<token>
REGISTRY_HOST=<registry_url>
CI_REGISTRY_IMAGE=${REGISTRY_HOST}/<project_path>

CV_TOKEN=<service_account_token>
CV_SERVERS=<comma_separated_cv_ip_or_hostname>
